{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Ordinary Universe approved comic manifest",
  "type": "object",
  "required": [
    "version",
    "comics"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "comics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "title",
          "status",
          "sequence",
          "published_at",
          "summary",
          "characters",
          "cover",
          "panels"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OU-[0-9]{3}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "const": "published"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "published_at": {
            "type": "string",
            "format": "date"
          },
          "summary": {
            "type": "string"
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cover": {
            "type": "string",
            "minLength": 1
          },
          "credits": {
            "type": "string"
          },
          "panels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "src",
                "alt",
                "transcript"
              ],
              "properties": {
                "src": {
                  "type": "string",
                  "minLength": 1
                },
                "alt": {
                  "type": "string",
                  "minLength": 1
                },
                "transcript": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
